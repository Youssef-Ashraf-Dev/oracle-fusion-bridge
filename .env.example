# Copy to .env and fill in. The scripts and the bot read it automatically; real environment variables win.
# --- secrets: host only, never committed ---
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
ORACLE_FUSION_BASE_URL=https://YOUR-NONPROD-POD.fa.ocs.oraclecloud.com
ORACLE_USERNAME=
ORACLE_PASSWORD=
ORACLE_FUSION_API_VERSION=11.13.18.05

# --- pod guards: the MCP exits at startup if ORACLE_FUSION_BASE_URL does not contain this text ---
ORACLE_ALLOWED_BASE_URLS=YOUR-NONPROD-POD.fa.ocs.oraclecloud.com
MCP_ENVIRONMENT=test
MCP_PROD_WRITES_ENABLED=false

# --- the planner skill Claude chat would load for this MCP ---
# Defaults to ./skill/ris-fusion-gateway-skill/SKILL.md. native = the Skill tool, as in chat; inline = system prompt; none.
# PLANNER_SKILL_PATH=
SKILL_MODE=native

# --- Day 2: try the Telegram side with no Oracle and no model (a canned, invented agent) ---
DEMO_MODE=false

# --- who may use the bot (Telegram numeric IDs, comma separated) ---
ALLOWED_TELEGRAM_USER_IDS=

# --- limits ---
MODEL=claude-haiku-5-5
# EFFORT=medium                # low | medium | high | xhigh | max; unset = the engine's default
MAX_MCP_OUTPUT_TOKENS=50000    # a larger tool result becomes a file the agent cannot open
RUN_BUDGET_USD=0.60            # per question; Day 1 sets this from measured runs
USER_DAILY_RUNS=100              # 0 = no daily limit; the monthly credit and the burst limit are the real guards
USER_BURST_RUNS=20              # at most this many questions per user in USER_BURST_MINUTES: catches loops and misuse
USER_BURST_MINUTES=10
SHOW_COST=all                   # who sees costs in footers and /usage: all | admin | none (use admin or none for a wider pilot)
ADMIN_TELEGRAM_USER_IDS=        # Telegram IDs that see costs when SHOW_COST=admin
ALLOW_HCM_SENSITIVE=false      # compensation, user accounts, worker profiles
DB_PATH=./data/bridge.db
# RECIPES_PATH=./skill/recipes.md   # verified notes about this pod, read by the model (default if the file exists)
SHUTDOWN_GRACE_S=3             # on a restart, running questions get this long to finish, then they are cancelled
SESSION_IDLE_MINUTES=120      # a conversation idle this long starts fresh (0 = never); /new always works
# ENGINE_DIR=./data/engine    # where the engine keeps saved conversations; they contain answers, so keep data/ private
